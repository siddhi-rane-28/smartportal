@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login - Smart Village</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Inter',sans-serif
            }

            body {
                min-height: 100vh;
                background: url('/images/index_hero_main_bg_v1.jpg') center/cover no-repeat fixed;
                position: relative;
                overflow: hidden
            }

                body::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: rgba(0,0,0,0.30)
                }

            .main {
                position: relative;
                z-index: 10;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 50px 60px;
                min-height: 100vh
            }

            .left {
                color: #fff;
                max-width: 460px
            }

            .badge {
                display: inline-flex;
                gap: 6px;
                background: rgba(0,0,0,0.35);
                border: 1px solid rgba(255,255,255,0.15);
                padding: 6px 12px;
                border-radius: 20px;
                font-size: 11px;
                backdrop-filter: blur(8px)
            }

            .left h1 {
                font-size: 48px;
                font-weight: 800;
                line-height: 1.1;
                margin-top: 18px;
                text-shadow: 0 4px 20px rgba(0,0,0,0.6)
            }

                .left h1 span {
                    color: #a7f3d0;
                    display: block;
                    margin-top: 4px
                }

            .left p {
                margin-top: 12px;
                font-size: 14px;
                opacity: 0.9
            }

            .card {
                width: 430px;
                background: rgba(18,18,18,0.82);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(255,255,255,0.12);
                border-radius: 18px;
                padding: 26px;
                box-shadow: 0 20px 60px rgba(0,0,0,0.6)
            }

                .card h2 {
                    color: #fff;
                    font-size: 20px;
                    display: flex;
                    align-items: center;
                    gap: 10px
                }

                .card .sub {
                    color: rgba(255,255,255,0.55);
                    font-size: 12px;
                    margin: 4px 0 18px 34px
                }

            .lbl {
                color: #fff;
                font-size: 11px;
                font-weight: 600;
                margin: 14px 0 6px;
                display: block
            }

            .inp {
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.15);
                border-radius: 10px;
                padding: 11px 12px
            }

                .inp input {
                    background: transparent;
                    border: none;
                    outline: none;
                    color: #fff;
                    width: 100%;
                    font-size: 12.5px
                }

                    .inp input::placeholder {
                        color: rgba(255,255,255,0.45)
                    }

                .inp svg {
                    opacity: 0.6;
                    flex-shrink: 0
                }

            input:-webkit-autofill {
                -webkit-box-shadow: 0 0 0px 1000px rgba(30,30,30,1) inset !important;
                -webkit-text-fill-color: #fff !important
            }

            .btn {
                width: 100%;
                background: #16a34a;
                border: none;
                padding: 12px;
                border-radius: 10px;
                color: #fff;
                font-weight: 700;
                margin-top: 20px;
                cursor: pointer;
                font-size: 13px
            }

                .btn:hover {
                    background: #15803d
                }

            .bottom {
                text-align: center;
                color: rgba(255,255,255,0.6);
                font-size: 11.5px;
                margin-top: 14px
            }

                .bottom a {
                    color: #4ade80;
                    text-decoration: none;
                    font-weight: 600
                }

            .toast {
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%,-50%) scale(0);
                background: #111;
                color: #fff;
                padding: 20px 28px;
                border-radius: 16px;
                text-align: center;
                z-index: 999;
                transition: 0.3s;
                box-shadow: 0 20px 50px rgba(0,0,0,0.5)
            }

                .toast.show {
                    transform: translate(-50%,-50%) scale(1)
                }

            .tick {
                width: 46px;
                height: 46px;
                background: #16a34a;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
                margin: 0 auto 8px
            }
    </style>
</head>
<body>
    <div class="main">
        <div class="left">
            <div class="badge">🌿 Build a Better Tomorrow</div>
            <h1>Smart Village <span>Kokan Chi Shan</span></h1>
            <p>Hartiyali, Kheti aur Aapla Gaon - Digital Zhalal</p>
        </div>

        <div class="card">
            <h2><span style="color:#4ade80">🔐</span> Login</h2>
            <div class="sub">Tumcha account me login kara</div>

            <form id="loginForm" method="post" action="/Home/Login" autocomplete="off">
                <label class="lbl">Mobile Number</label>
                <div class="inp">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                    <input name="Mobile" type="text" inputmode="numeric" placeholder="Tumcha Mobile Number" value="" autocomplete="off" required />
                </div>

                <label class="lbl">Password</label>
                <div class="inp">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                    <input name="Password" type="password" placeholder="Tumcha Password" value="" autocomplete="new-password" required />
                </div>

                <button class="btn" type="submit">Login →</button>
            </form>

            <div class="bottom">Account nahi hai? <a href="/Home/Index">Create Account</a></div>
        </div>
    </div>

    <!-- CHOTA SA TICK POPUP -->
    <div class="toast" id="toast">
        <div class="tick">✓</div>
        <div style="font-weight:700;font-size:14px">Login Successful!</div>
        <div style="font-size:11px;opacity:0.7;margin-top:3px">Account login zala, Dashboard open hotoy...</div>
    </div>

    <script>
            const form = document.getElementById('loginForm');
            const toast = document.getElementById('toast');
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                if (!form.checkValidity()) { form.reportValidity(); return; }
                toast.classList.add('show');
                setTimeout(() => { form.submit(); }, 1300);
            });
    </script>
</body>
</html>