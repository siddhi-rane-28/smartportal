@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Smart Village - Login</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: Arial
            }

            body {
                display: flex;
                height: 100vh;
                overflow: hidden
            }

            .left {
                width: 50%;
                background: #000 url('/images/kokan.jpg') center/cover no-repeat;
                position: relative;
            }

                .left::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: linear-gradient(to top, rgba(0,0,0,0.65), rgba(0,0,0,0.05));
                }

            .left-content {
                position: absolute;
                bottom: 35px;
                left: 28px;
                z-index: 2;
                color: white
            }

            .right {
                width: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #fffef5
            }

            .box {
                width: 380px;
                padding: 24px
            }

            .title {
                font-size: 26px;
                font-weight: bold;
                color: #0d4d2b;
                text-align: center
            }

            .sub {
                font-size: 13px;
                color: #666;
                text-align: center;
                margin: 8px 0 22px
            }

            label {
                font-size: 13px;
                font-weight: 600;
                margin-top: 14px;
                display: block
            }

            .inp {
                width: 100%;
                padding: 12px;
                border: 1px solid #ddd;
                border-radius: 8px;
                background: #fefce8;
                margin-top: 6px;
                outline: none
            }

            .btn {
                width: 100%;
                background: #0d4d2b;
                color: white;
                padding: 13px;
                border: none;
                border-radius: 8px;
                font-weight: bold;
                margin-top: 20px;
                cursor: pointer
            }

                .btn:hover {
                    background: #09381f
                }

            #loginForm {
                display: none
            }

            .link {
                display: block;
                text-align: center;
                margin-top: 14px;
                font-size: 13px;
                color: #0d4d2b;
                cursor: pointer
            }

            @@media(max-width:768px) {
                body {
                    flex-direction: column;
                    overflow: auto
                }

                .left {
                    width: 100%;
                    height: 45vh
                }

                .right {
                    width: 100%
                }
            }
    </style>
</head>
<body>

    <div class="left">
        <div class="left-content">
            <h2 style="font-size:27px;line-height:1.2">Smart Village<br>Kokan Chi Shan</h2>
            <p style="font-size:13px;margin-top:8px;opacity:0.95">Hariyali, Kheti aur Aapla Gaon - Digital Zhala!</p>
        </div>
    </div>

    <div class="right">
        <div class="box">

            <!-- STEP 1: Create Account + Basic Info -->
            <div id="createForm">
                <div class="title">Create Account</div>
                <div class="sub">Basic info bhara ani account banva</div>
                <label>Full Name</label><input class="inp" placeholder="Tumcha Nav" />
                <label>Gaon / Village</label><input class="inp" placeholder="Ex: Malvan, Kokan" />
                <label>Mobile Number</label><input class="inp" placeholder="98765XXXXX" />
                <label>Password</label><input class="inp" type="password" placeholder="Password banva" />
                <button class="btn" onclick="showLogin()">Create Account →</button>
                <span class="link" onclick="showLogin()">Already have account? Login</span>
            </div>

            <!-- STEP 2: Login - Basic info ke baad ye khulega -->
            <div id="loginForm">
                <div class="title">Welcome Back!</div>
                <div class="sub">Login to Smart Village Portal</div>
                <label>Mobile / Username</label><input class="inp" value="admin" />
                <label>Password</label><input class="inp" type="password" value="admin" />
                <button class="btn" onclick="location.href='/Home/Dashboard'">Login →</button>
                <span class="link" onclick="showCreate()">New user? Create Account</span>
                <a href="/" style="display:block;text-align:center;margin-top:12px;font-size:12px;color:#888;text-decoration:none">← Back to Home</a>
            </div>

        </div>
    </div>

    <script>
            function showLogin() { document.getElementById('createForm').style.display = 'none'; document.getElementById('loginForm').style.display = 'block'; }
            function showCreate() { document.getElementById('loginForm').style.display = 'none'; document.getElementById('createForm').style.display = 'block'; }
    </script>
</body>
</html>