@{
    ViewData["Title"] = "Youth Employment Services";
}
<div class="container mt-4">
    <div class="p-4 mb-4 rounded-4 text-white text-center" style="background: linear-gradient(135deg,#FF6A00,#EE0979);">
        <h2 class="fw-bold">🚀 Yuva Gaon, Rozgar Gaon</h2>
        <p class="mb-0">Empowering Rural Youth - Every Youth Gets Work | गावातील युवकांना रोजगार</p>
    </div>

    <div class="row g-4">
        <!-- 1. Govt Prep -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow border-0 rounded-4">
                <img src="/images/employment/govt-prep.jpg" onerror="this.src='https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=600&h=400&fit=crop'" style="height:220px;object-fit:cover;object-position:top;" class="card-img-top rounded-top-4" alt="Govt Prep">
                <div class="card-body text-center">
                    <h6 class="fw-bold">Govt Job Preparation</h6>
                    <p class="small text-muted">MPSC / Police Bharti / Talathi - गावातूनच तयारी</p>
                    <a href="/Home/EmploymentDetails?id=govt-prep" class="btn btn-dark w-100 rounded-pill">View Details</a>
                </div>
            </div>
        </div>
        <!-- 2. Private Jobs -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow border-0 rounded-4">
                <img src="/images/employment/private-jobs.jpg" onerror="this.src='https://images.unsplash.com/photo-1556761175-5973dc0f32e7?w=600&h=400&fit=crop'" style="height:220px;object-fit:cover;object-position:top;" class="card-img-top rounded-top-4" alt="Private Jobs">
                <div class="card-body text-center">
                    <h6 class="fw-bold">Private Jobs & Rozgar Melava</h6>
                    <p class="small text-muted">Pune-Mumbai Company Job Fair - थेट मुलाखत</p>
                    <a href="/Home/EmploymentDetails?id=private-jobs" class="btn btn-dark w-100 rounded-pill">View Details</a>
                </div>
            </div>
        </div>
        <!-- 3. Skill to Job -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow border-0 rounded-4">
                <img src="/images/employment/skill-job.jpg" onerror="this.src='https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=600&h=400&fit=crop'" style="height:220px;object-fit:cover;object-position:top;" class="card-img-top rounded-top-4" alt="Skill">
                <div class="card-body text-center">
                    <h6 class="fw-bold">Skill to Job - PMKVY / ITI</h6>
                    <p class="small text-muted">3 महिन्यात शिका, नोकरी मिळवा - मोफत</p>
                    <a href="/Home/EmploymentDetails?id=skill-job" class="btn btn-dark w-100 rounded-pill">View Details</a>
                </div>
            </div>
        </div>
        <!-- 4. Startup -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow border-0 rounded-4">
                <img src="/images/employment/startup.jpg" onerror="this.src='https://images.unsplash.com/photo-1556761175-b413da4baf72?w=600&h=400&fit=crop'" style="height:220px;object-fit:cover;object-position:top;" class="card-img-top rounded-top-4" alt="Startup">
                <div class="card-body text-center">
                    <h6 class="fw-bold">Startup & Self Employment</h6>
                    <p class="small text-muted">Mudra Loan 10 Lakh पर्यंत - दुकान सुरु करा</p>
                    <a href="/Home/EmploymentDetails?id=startup" class="btn btn-dark w-100 rounded-pill">View Details</a>
                </div>
            </div>
        </div>
        <!-- 5. Digital Jobs -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow border-0 rounded-4">
                <img src="/images/employment/digital-jobs.jpg" onerror="this.src='https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&h=400&fit=crop'" style="height:220px;object-fit:cover;" class="card-img-top rounded-top-4" alt="Digital">
                <div class="card-body text-center">
                    <h6 class="fw-bold">Digital & IT Jobs</h6>
                    <p class="small text-muted">Work From Home - गावातूनच कमवा</p>
                    <a href="/Home/EmploymentDetails?id=digital-jobs" class="btn btn-dark w-100 rounded-pill">View Details</a>
                </div>
            </div>
        </div>
        <!-- 6. Abroad Job -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow border-0 rounded-4">
                <img src="/images/employment/abroad-job.jpg" onerror="this.src='https://images.unsplash.com/photo-1523906834658-6e24ef2386f9?w=600&h=400&fit=crop'" style="height:220px;object-fit:cover;" class="card-img-top rounded-top-4" alt="Abroad">
                <div class="card-body text-center">
                    <h6 class="fw-bold">Abroad Job / Foreign</h6>
                    <p class="small text-muted">Dubai, Gulf, Europe - Legal Jobs</p>
                    <a href="/Home/EmploymentDetails?id=abroad-job" class="btn btn-dark w-100 rounded-pill">View Details</a>
                </div>
            </div>
        </div>
        <!-- 7. Apprenticeship -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow border-0 rounded-4">
                <img src="/images/employment/apprenticeship.jpg" onerror="this.src='https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=600&h=400&fit=crop'" style="height:220px;object-fit:cover;" class="card-img-top rounded-top-4" alt="Apprentice">
                <div class="card-body text-center">
                    <h6 class="fw-bold">Apprenticeship & Internship</h6>
                    <p class="small text-muted">Earn While You Learn + Stipend</p>
                    <a href="/Home/EmploymentDetails?id=apprenticeship" class="btn btn-dark w-100 rounded-pill">View Details</a>
                </div>
            </div>
        </div>
        <!-- 8. Career Guidance -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow border-0 rounded-4">
                <img src="/images/employment/career-guidance.jpg" onerror="this.src='https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=600&h=400&fit=crop'" style="height:220px;object-fit:cover;" class="card-img-top rounded-top-4" alt="Career">
                <div class="card-body text-center">
                    <h6 class="fw-bold">Career Guidance & Counseling</h6>
                    <p class="small text-muted">12वी नंतर काय? Expert मदत</p>
                    <a href="/Home/EmploymentDetails?id=career-guidance" class="btn btn-dark w-100 rounded-pill">View Details</a>
                </div>
            </div>
        </div>
    </div>
</div>