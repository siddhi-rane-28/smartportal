@{
    var appId = ViewBag.AppId as string;
}
<div class="container mt-4" style="max-width:600px;">
    <div class="card shadow border-0 rounded-4 p-4 text-center">
        <h2 class="text-success">✅ Application Submitted!</h2>
        <h4 class="mt-3">@ViewBag.Scheme</h4>
        <div class="mt-3 text-start bg-light p-3 rounded-3">
            <p><strong>Application ID:</strong> @appId</p>
            <p><strong>Name:</strong> @ViewBag.Name</p>
            <p><strong>Mobile:</strong> @ViewBag.Mobile</p>
            <p><strong>Education:</strong> @ViewBag.Education</p>
            <p><strong>Skill:</strong> @ViewBag.Skill</p>
            <p><strong>Date:</strong> @ViewBag.Date</p>
        </div>
        <p class="small text-muted mt-3">Your application for youth employment has been received. Our team will contact you within 3 days.</p>
        <a href="/Home/EmploymentServices" class="btn btn-dark rounded-pill mt-3">Back to Employment</a>
        <a href="/" class="btn btn-outline-dark rounded-pill mt-3 ms-2">Go to Dashboard</a>
    </div>
</div>
