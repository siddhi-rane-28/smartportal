@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Smart Village - Kokan Chi Shan</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Inter',sans-serif
            }

            body {
                min-height: 100vh;
                background: url('~/images/kokan.jpg'), url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1920') center/cover no-repeat fixed;
                position: relative;
                overflow: hidden;
            }

                body::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: rgba(0,0,0,0.25)
                }

            .navbar {
                position: relative;
                z-index: 10;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 22px 50px;
                color: #fff
            }

            .logo {
                font-size: 19px;
                font-weight: 800;
                display: flex;
                align-items: center;
                gap: 8px
            }

                .logo span {
                    color: #a7f3d0
                }

            .nav a {
                color: #fff;
                text-decoration: none;
                margin-left: 24px;
                font-size: 13px;
                opacity: 0.9
            }

            .main {
                position: relative;
                z-index: 10;
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                padding: 40px 50px 50px;
                min-height: calc(100vh - 80px)
            }

            .left {
                color: #fff;
                max-width: 460px;
                margin-bottom: 20px
            }

            .badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: rgba(0,0,0,0.35);
                border: 1px solid rgba(255,255,255,0.15);
                padding: 6px 12px;
                border-radius: 20px;
                font-size: 11px;
                backdrop-filter: blur(8px)
            }

            .left h1 {
                font-size: 42px;
                font-weight: 800;
                line-height: 1.1;
                margin-top: 18px
            }

                .left h1 span {
                    color: #a7f3d0;
                    display: block;
                    margin-top: 4px
                }

            .left p {
                margin-top: 12px;
                font-size: 13px;
                opacity: 0.9
            }

            .card {
                width: 420px;
                background: rgba(18,18,18,0.82);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(255,255,255,0.12);
                border-radius: 18px;
                padding: 24px;
                box-shadow: 0 20px 60px rgba(0,0,0,0.6)
            }

                .card h2 {
                    color: #fff;
                    font-size: 20px;
                    display: flex;
                    align-items: center;
                    gap: 10px
                }

                .card .sub {
                    color: rgba(255,255,255,0.55);
                    font-size: 12px;
                    margin: 4px 0 18px 34px
                }

            .lbl {
                color: #fff;
                font-size: 11px;
                font-weight: 600;
                margin: 14px 0 6px;
                display: block
            }

            .inp {
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.15);
                border-radius: 10px;
                padding: 11px 12px
            }

                .inp input {
                    background: transparent;
                    border: none;
                    outline: none;
                    color: #fff;
                    width: 100%;
                    font-size: 12.5px
                }

                    .inp input::placeholder {
                        color: rgba(255,255,255,0.45)
                    }

                .inp svg {
                    opacity: 0.6;
                    flex-shrink: 0
                }

            .btn {
                width: 100%;
                background: #16a34a;
                border: none;
                padding: 12px;
                border-radius: 10px;
                color: #fff;
                font-weight: 700;
                margin-top: 20px;
                cursor: pointer;
                font-size: 13px
            }

                .btn:hover {
                    background: #15803d
                }

            .bottom {
                text-align: center;
                color: rgba(255,255,255,0.6);
                font-size: 11.5px;
                margin-top: 14px
            }

                .bottom a {
                    color: #4ade80;
                    text-decoration: none;
                    font-weight: 600
                }

            @@media(max-width:900px) {
                body {
                    overflow: auto
                }

                .main {
                    flex-direction: column;
                    align-items: center;
                    padding: 20px;
                    gap: 30px
                }

                .left {
                    max-width: 100%;
                    margin-bottom: 0
                }

                    .left h1 {
                        font-size: 32px
                    }

                .card {
                    width: 100%;
                    max-width: 420px
                }

                .navbar {
                    padding: 16px 20px
                }

                .nav {
                    display: none
                }
            }
    </style>
</head>
<body>
    <div class="navbar">
        <div class="logo">🌿 Smart <span>Village</span></div>
        <div class="nav"><a href="/">Home</a><a href="#">About</a><a href="#">Contact</a></div>
    </div>

    <div class="main">
        <div class="left">
            <div class="badge">🌿 Build a Better Tomorrow</div>
            <h1>Smart Village <span>Kokan Chi Shan</span></h1>
            <p>Hartiyali, Kheti aur Aapla Gaon - Digital Zhalal</p>
        </div>

        <div class="card">
            <h2><span style="color:#4ade80">👤</span> Create Account</h2>
            <div class="sub">Basic info bhara ani account banva</div>

            <form method="post" action="/Home/Register">
                <label class="lbl">Full Name</label>
                <div class="inp">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    <input name="FullName" />
                </div>

                <label class="lbl">Gaon / Village</label>
                <div class="inp">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                    <input name="Village" />
                </div>

                <label class="lbl">Mobile Number</label>
                <div class="inp">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                    <input name="Mobile" p/>
                </div>

                <label class="lbl">Password</label>
                <div class="inp">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                    <input name="Password" type="password"/>
                    <span style="margin-left:auto;opacity:0.5;cursor:pointer">👁‍🗨</span>
                </div>

                <button class="btn" type="submit">Create Account →</button>
            </form>

            <div class="bottom">Already have account? <a href="/Home/Login">Login</a></div>
        </div>
    </div>
</body>
</html>