@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Smart Village Portal</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box
            }

            body {
                height: 100vh;
                width: 100vw;
                background: url('/images/index_hero_main_bg_v1.jpg') center/cover no-repeat;
                overflow: hidden;
                position: relative;
            }

            .enter-link {
                position: absolute;
                left: 50%;
                top: 68.5%;
                transform: translate(-50%, -50%);
                width: 180px; /* Box ka size same - aapki photo ke button jitna */
                height: 50px; /* Box ka size same */
                display: block;
                cursor: pointer;
            }
    </style>
</head>
<body>
    <a href="/Home/Register" class="enter-link"></a>
</body>
</html>