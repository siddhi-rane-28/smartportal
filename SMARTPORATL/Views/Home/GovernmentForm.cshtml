@{
    var scheme = ViewBag.Scheme as string ?? "Government Scheme";
}
<div class="container mt-4" style="max-width:650px;">
    <a href="/Home/GovernmentSchemes" class="btn btn-dark btn-sm mb-3">← Back to Schemes</a>
    <div class="card shadow-lg p-4 border-0" style="border-radius:15px;">
        <h4 class="fw-bold text-success text-center">Apply for @scheme</h4>
        <p class="text-muted text-center small">Fill your details correctly. All fields are mandatory.</p>
        <hr />
        <form action="/Home/GovernmentReceipt" method="get">
            <input type="hidden" name="scheme" value="@scheme" />

            <div class="mb-3">
                <label class="fw-bold">Full Name (Aadhaar Wise)</label>
                <input name="name" type="text" class="form-control" placeholder="Enter your full name" />
            </div>
            <div class="row g-2">
                <div class="col-6 mb-3">
                    <label class="fw-bold">Mobile Number</label>
                    <input name="mobile" type="text" class="form-control" placeholder="10 digit mobile" value="9876543210" />
                </div>
                <div class="col-6 mb-3">
                    <label class="fw-bold">Aadhaar Number</label>
                    <input name="aadhaar" type="text" class="form-control" placeholder="12 digit Aadhaar" value="123412341234" />
                </div>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Village / City</label>
                <input name="village" type="text" class="form-control" placeholder="Enter village name" value="Pune" />
            </div>
            <div class="mb-3">
                <label class="fw-bold">Bank Account Number</label>
                <input name="bank" type="text" class="form-control" placeholder="Enter bank account" value="1234567890" />
            </div>

            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" checked />
                <label class="form-check-label small">I declare that all information is true and correct.</label>
            </div>

            <button type="submit" class="btn btn-success w-100 btn-lg" style="border-radius:10px;">Submit Application →</button>
        </form>
    </div>
</div>