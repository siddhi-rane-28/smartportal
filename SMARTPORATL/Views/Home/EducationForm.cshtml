@{
    Layout = null; var scheme = Context.Request.Query["scheme"].ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            body {
                background: #e8f0ff;
                font-family: Arial
            }

            .box {
                max-width: 550px;
                margin: 30px auto;
                background: white;
                padding: 25px;
                border-radius: 16px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.1)
        }</style>
    </head>
    <body>
        <div class="box">
            <h4 style="color:#1565c0;text-align:center">📚 Apply - @scheme</h4>
            <form action="/Home/EducationReceipt" method="get">
                <input type="hidden" name="scheme" value="@scheme" />
                <div class="mb-3"><label>Name *</label><input name="name" class="form-control" required /></div>
                <div class="mb-3"><label>Mobile *</label><input name="mobile" class="form-control" required /></div>
                <div class="mb-3"><label>Aadhaar *</label><input name="aadhaar" class="form-control" required /></div>
                <button class="btn btn-primary w-100">Submit →</button>
                <a href="/Home/EducationServices" class="btn btn-secondary w-100 mt-2">Back</a>
            </form>    </div>
        </body>
    </html>