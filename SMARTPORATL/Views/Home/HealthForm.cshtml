@{
    Layout = null;
    // Scheme name URL se lena - dono tarah se support
    var scheme = Context.Request.Query["scheme"].ToString();
    if (string.IsNullOrEmpty(scheme)) { scheme = ViewBag.Scheme as string ?? "Health Service Request"; }
    if (string.IsNullOrEmpty(scheme)) { scheme = "Health Service Request"; }

    // === FORM PAGE KI PHOTO - Front wali same photo ayegi ===
    string photo = "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=1200";
    if (scheme.ToLower().Contains("medical")) { photo = "https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?w=1200"; }
    else if (scheme.ToLower().Contains("emergency") || scheme.ToLower().Contains("108") || scheme.ToLower().Contains("ambulance")) { photo = "https://d35oenyzp35321.cloudfront.net/emergency_critical_care_d8e396be8b.jpg"; }
    else if (scheme.ToLower().Contains("camp")) { photo = "https://www.indiabullsfoundation.com/uploads/product/medical-camp-1-0030282001558621335.jpg"; }
    else if (scheme.ToLower().Contains("vaccine") || scheme.ToLower().Contains("vaccination")) { photo = "https://images.unsplash.com/photo-1605289982774-9a6fef564df8?w=1200"; }
    else if (scheme.ToLower().Contains("hospital") || scheme.ToLower().Contains("nearest") || scheme.ToLower().Contains("bhagat")) { photo = "https://images.unsplash.com/photo-1538108149393-fbbd81895907?w=1200"; }
    else if (scheme.ToLower().Contains("aushadhi") || scheme.ToLower().Contains("jan")) { photo = "https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=1200"; }
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Apply - @scheme</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            body {
                margin: 0;
                font-family: Arial;
                background: #f5f5f5
            }

            .top-img {
                width: 100%;
                height: 280px;
                object-fit: cover;
                display: block
            }

            .back {
                position: absolute;
                top: 10px;
                left: 10px;
                background: #222;
                color: white;
                padding: 6px 14px;
                border-radius: 20px;
                text-decoration: none;
                font-size: 12px;
                z-index: 10
            }

            .card-main {
                max-width: 600px;
                margin: -60px auto 20px;
                background: white;
                border-radius: 16px;
                padding: 22px;
                box-shadow: 0 8px 25px rgba(0,0,0,0.25);
                position: relative
            }

            h4.fw-bold {
                color: #b71c1c;
                text-align: center
            }

            .btn-danger {
                border-radius: 10px;
                font-weight: bold;
                padding: 12px
            }
    </style>
</head>
<body>
    <a href="/Home/HealthServices" class="back">◀ Back</a>
    <!-- FORM PAGE KI PHOTO - AB DIKHEGI - SAME AS FRONT -->
    <img src="@photo" class="top-img" onerror="this.src='https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=600'" />

    <div class="card-main">
        <h4 class="fw-bold">Apply for @scheme</h4>
        <p class="text-center text-muted" style="font-size:12px">Fill this form for @scheme</p>

        <div class="card shadow p-4 mt-3 border-0" style="box-shadow:none !important; padding:0 !important;">
            <!-- Receipt page pe jayega -->
            <form action="/Home/HealthReceipt" method="get">
                <input type="hidden" name="scheme" value="@scheme" />

                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size:13px">Full Name</label>
                    <input name="name" class="form-control" required placeholder="Enter your name" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size:13px">Mobile Number</label>
                    <input name="mobile" class="form-control" pattern="[0-9]{10}" required placeholder="10 digit mobile" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size:13px">Village / Area</label>
                    <input name="village" class="form-control" required placeholder="Village name" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size:13px">Aadhaar Number</label>
                    <input name="aadhaar" class="form-control" required placeholder="12 digit Aadhaar" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size:13px">Problem / Requirement</label>
                    <textarea name="problem" class="form-control" rows="3" placeholder="Describe your problem"></textarea>
                </div>
                <button class="btn btn-danger w-100">Submit Request & Get Receipt →</button>
            </form>
        </div>
    </div>
</body>
</html>