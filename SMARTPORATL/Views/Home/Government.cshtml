@{
    ViewBag.Title = "Government Schemes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm text-center p-4" style="border:2px solid #2e7d32;">
        <img src="~/images/VillageDev/govt.jpg"
             style="width:100%; height:180px; object-fit:cover; border-radius:10px;"
             onerror="this.src='https://images.unsplash.com/photo-1529107386315-e1a2ed48a620?w=400'" />

        <h4 class="mt-3">🏛️ Government Schemes</h4>
        <p>All Sarkari Yojana - Central & State Govt</p>

        <div class="row g-2 mt-2">
            <div class="col-md-6">
                <a href="/Dashboard/GovernmentSchemesSchemeDetail" class="btn btn-success w-100">View All Yojana</a>
            </div>
            <div class="col-md-6">
                <a href="/Dashboard/GovernmentSchemesSchemeDetail" class="btn btn-outline-success w-100">Online Apply</a>
            </div>
        </div>

        <div class="alert alert-light mt-3 text-start">
            <small>
                <b>Offline:</b> Grampanchayat Office / Setu Kendra<br />
                <b>Time:</b> 10 AM to 5 PM<br />
                <b>Docs:</b> Aadhaar, Ration Card, Income Certificate
            </small>
        </div>
    </div>
</div>