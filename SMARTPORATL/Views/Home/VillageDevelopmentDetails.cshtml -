vv@{
    var id = ViewBag.ServiceId as string ?? "Water";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head><meta name="viewport" content="width=device-width, initial-scale=1">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial}body{background:#f5f7fa}
.header{background:#062d11;color:#f5c518;padding:12px 18px;display:flex;justify-content:space-between}
.header a{background:white;color:#000;padding:6px 14px;border-radius:18px;text-decoration:none;font-size:11px;font-weight:bold}
.box{max-width:750px;margin:20px auto;background:white;border-radius:14px;overflow:hidden;box-shadow:0 4px 18px rgba(0,0,0,0.1)}
.box img{width:100%;height:260px;object-fit:cover}
.content{padding:20px}.content p{font-size:12px;line-height:20px;margin:5px 0}
.badge{padding:4px 10px;border-radius:12px;font-size:10px;color:white;font-weight:bold;margin-right:5px}.g{background:#2e7d32}.o{background:#ef6c00}.b{background:#1565c0}
input,textarea{width:100%;padding:9px;border:1px solid #ccc;border-radius:8px;margin-top:8px;font-size:12px}
.btn{width:100%;padding:10px;border:none;border-radius:20px;color:white;font-weight:bold;margin-top:10px;cursor:pointer}
</style>
</head>
<body>
<div class="header"><b>@id Details</b><a href="/Home/VillageDevelopment">← Back</a></div>
<div class="box">
@if(id=="Water"){
    <img src="https://apexcos.com/wp-content/uploads/water-supply-intro-2-e1641313204540.jpg"/>
    <div class="content">
    <h2>💧 Water Supply</h2>
    <span class="badge g">Jal Jeevan</span><span class="badge b">Har Ghar Nal</span>
    <p><b>About:</b> Gaon me shudh pani purvatha</p>
    <p><b>Benefit:</b> 24x7 Water, Free BPL Connection</p>
    <p><b>Eligibility:</b> All villagers</p>
    <p><b>Docs:</b> Aadhar, Ghar Patti</p>
    <p><b>Online:</b> ejal.gov.in par bill pay</p>
    <p><b>Offline:</b> GP Office 10 to 5 PM</p>
    </div>
}
else if(id=="Electricity"){
    <img src="https://www.globalelectricity.org/wp-content/uploads/2026/07/this-week-in-electricity-2026-07-30.jpg"/>
    <div class="content"><h2>⚡ Electricity</h2><p><b>About:</b> Mahavitaran<br/><b>Complaint:</b> DP Fault, Meter Issue<br/><b>Online:</b> wss.mahadiscom.in<br/><b>Helpline:</b> 1912</p></div>
}
else if(id=="Roads"){
    <img src="https://sujeetengineering.solutions/image/road-construction.webp"/>
    <div class="content"><h2>🛣️ Roads & Infrastructure</h2><p><b>About:</b> Rasta Construction & Repair<br/><b>Process:</b> Photo ke saath complaint karo, 7 din me kaam</p></div>
}
else if(id=="Garbage"){
    <img src="https://static.pib.gov.in/WriteReadData/userfiles/image/Screenshot2024-09-17153054ZXE1.png"/>
    <div class="content"><h2>🗑️ Garbage & Swachhata</h2><p><b>About:</b> Going Zero Waste - Swachh Bharat<br/><b>Service:</b> Daily Van 7 AM<br/><b>Complaint:</b> Van nahi aayi</p></div>
}
else if(id=="StreetLight"){
    <img src="https://lumencity.in/wp-content/uploads/2023/09/1-10.jpg"/>
    <div class="content"><h2>💡 Street Light</h2><p><b>About:</b> Solar & LED Lights<br/><b>Complaint:</b> Pole No. ke saath photo bhejo</p></div>
}
else{
    <img src="https://5.imimg.com/data5/SELLER/Default/2023/7/325093273/AN/LW/YM/162283999/new-product-500x500.jpeg"/>
    <div class="content"><h2>🏫 Grampanchayat Work</h2><p><b>About:</b> School, Mandir, Hall Construction<br/><b>Meeting:</b> Monday 11 AM</p></div>
}
    <div class="content" style="padding-top:0">
        <hr style="margin:15px 0"/>
        <h3 style="font-size:14px">📸 Complaint with Photo</h3>
        <form method="post" action="/Home/SubmitVillageComplaint" enctype="multipart/form-data">
            <input type="hidden" name="type" value="@id"/>
            <textarea name="description" placeholder="Takrar likho..." required></textarea>
            <input type="file" name="photo" accept="image/*" required/>
            <button type="submit" class="btn" style="background:#c62828">Submit Complaint</button>
        </form>
        <a href="https://ejal.gov.in" target="_blank" class="btn" style="background:#2e7d32;display:block;text-align:center;text-decoration:none">💻 Online Bill Pay</a>
    </div>
</div>
</body>
</html>